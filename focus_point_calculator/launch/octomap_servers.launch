<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <arg name="use_low_res" default="true"/>
  <arg name="fine_res" default="0.03"/>
  <arg name="coarse_res" default="0.12"/>
  <arg name="max_range" default="4.5"/>

  <!-- Fine-resolution octomap server in its own namespace -->
  <group ns="octomap_server_fine">
    <node name="octomap_server" pkg="octomap_server" type="octomap_server_node" output="screen" clear_params="true">
      <param name="frame_id" value="world"/>
      <param name="resolution" value="$(arg fine_res)"/>
      <param name="base_frame_id" value="kinect_depth"/>
      <param name="sensor_model/max_range" value="$(arg max_range)"/>
      <param name="filter_ground" value="true"/>
      <remap from="cloud_in" to="/world/pcl_input"/>
    </node>
  </group>

  <!-- Coarse-resolution octomap server in its own namespace -->
  <group ns="octomap_server_coarse" if="$(arg use_low_res)">
    <node name="octomap_server" pkg="octomap_server" type="octomap_server_node" output="screen" clear_params="true">
      <param name="frame_id" value="world"/>
      <param name="resolution" value="$(arg coarse_res)"/>
      <param name="base_frame_id" value="kinect_depth"/>
      <param name="sensor_model/max_range" value="$(arg max_range)"/>
      <param name="filter_ground" value="true"/>
      <remap from="cloud_in" to="/world/pcl_input"/>
    </node>
  </group>

</launch>